<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Delta.Diagnostics</AssemblyName>
    <PackageId>Delta.Diagnostics</PackageId>
    <Version>0.0.8</Version>
    <Authors>Artromskiy</Authors>
    <Description>Implementation-neutral diagnostics, logging, and profiling APIs for .NET.</Description>
    <PackageTags>diagnostics;logging;profiling;aot</PackageTags>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaDiagnostics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RootNamespace>Delta.Diagnostics</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/../../README.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
  </ItemGroup>
</Project>
